# --- Python bytecode ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments ---
# The venv for this repo lives outside it, in ../virtual-envs/chrome-tests/,
# but ignore local ones too in case anyone creates one here.
.venv/
venv/
env/

# --- Tool caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Secrets and local configuration ---
.env
.env.*
!.env.example

# --- Test artifacts (screenshots, traces, reports) ---
# Produced by test runs; regenerated every time, never source.
/artifacts/
/reports/
/screenshots/
*.log

# --- Editors ---
.idea/
.vscode/
*.swp

# --- OS ---
Thumbs.db
desktop.ini
.DS_Store

# NOTE: uv.lock is deliberately NOT ignored. The lockfile pins exact versions
# of every dependency, which is what makes "clone the repo and run the tests"
# reproducible on another machine and in CI.
